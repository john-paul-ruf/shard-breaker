{
  "name": "shardbreak",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Responsive, desktop-first, one-pointer browser roguelite combining brick-breaker combat with seeded run drafting.",
  "engines": {
    "node": "^22.17.0"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint . && stylelint \"./src/**/*.css\" --allow-empty-input",
    "typecheck": "tsc -b --pretty false",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "build": "tsc -b --pretty false && vite build",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run build"
  },
  "stylelint": {
    "extends": "stylelint-config-standard",
    "rules": {
      "custom-property-pattern": null,
      "custom-property-empty-line-before": null,
      "value-keyword-case": [
        "lower",
        {
          "ignoreProperties": [
            "--*"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
